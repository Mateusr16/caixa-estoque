# ID da planilha (o trecho entre /d/ e /edit na URL do Google Sheets)
SHEET_ID=

# Conteúdo COMPLETO do arquivo JSON da conta de serviço (pode colar o JSON inteiro ou em base64)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Senha de acesso ao sistema (deixe vazio para acesso livre — não recomendado)
APP_PASSWORD=

# Opcionais
SESSION_SECRET=troque-por-um-texto-aleatorio
TIMEZONE=America/Sao_Paulo
CACHE_SECONDS=20
EXIGIR_CAIXA_ABERTO=true
PERMITIR_ESTOQUE_NEGATIVO=false
